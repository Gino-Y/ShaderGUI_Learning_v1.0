{
  "contractId": "course-home-progress-state-v1",
  "status": "workflow_ready",
  "ownerRole": "workflow/DAG",
  "productSurface": "CourseApp/src/views/CourseHome.vue",
  "templateSource": ".agent/templates/course-app/src/views/CourseHome.vue",
  "storage": {
    "kind": "localStorage",
    "key": "shadergui-module-progress-v1",
    "shape": {
      "<moduleId>": "number level from 0 to 4"
    }
  },
  "states": [
    { "key": "watched", "label": "看过", "level": 1, "requires": [] },
    { "key": "learned", "label": "学过", "level": 2, "requires": ["watched"] },
    { "key": "practiced", "label": "已做题", "level": 3, "requires": ["watched", "learned"] },
    { "key": "mastered", "label": "掌握", "level": 4, "requires": ["watched", "learned", "practiced"] }
  ],
  "semantics": {
    "orderedLevel": true,
    "laterStateImpliesEarlierStates": true,
    "toggleSameLevelStepsBack": true,
    "clampPersistedLevelRange": [0, 4]
  },
  "modulePolicy": {
    "source": "CourseContent/Module_*/course.json via MVPMCP course.json assembly",
    "displayOnlyRealModules": true,
    "noFabricatedModules": true,
    "fallbackTitlesForbidden": ["Module_02", "Module_03", "Module_04"]
  },
  "forbiddenWrites": [
    "CourseContent/",
    "CourseApp/src/data/course.json",
    "CourseApp/src/data/slides.json",
    "CourseApp/src/data/storyboard-contract.json",
    "CourseApp/src/data/design-contract.json",
    "CourseApp/src/data/stitch-manifest.json"
  ],
  "acceptance": [
    "Course home cards show semantic module title and summary from module metadata.",
    "Cards expose progress choices: 看过, 学过, 已做题, 掌握.",
    "Progress persists only in localStorage key shadergui-module-progress-v1.",
    "Selecting a later state implies all earlier states.",
    "Execution layer regenerates CourseApp through MVP/ADP instead of hand-editing product files."
  ]
}
